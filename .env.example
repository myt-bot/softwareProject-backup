# 环境变量模板：复制为 .env 后按需修改（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env
#
# 不创建 .env 时，docker compose 使用下面这些开发默认值，开箱即用。
# 生产部署必须修改为强密码/强密钥。

MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=visual_dl
JWT_SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=mysql+pymysql://root:devroot@127.0.0.1:3306/visual_dl?charset=utf8mb4
